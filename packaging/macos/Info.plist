<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shown in macOS's microphone permission prompt. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Bars listens while you hold your dictation shortcut and transcribes your speech on this Mac.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Bars mutes other apps while you dictate, if you turn that on in its settings. It never records their audio.</string>
    <!-- A menu-bar app: no Dock icon or app menu. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
